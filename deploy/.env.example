# Template for deploy/.env - the only env file. Copy it to deploy/.env and fill in.
# deploy/.env is read by settings.py when running locally and by
# deploy/docker-compose.prod.yml in Docker (which overrides POSTGRES_HOST=db and
# sets DJANGO_ENV=production). It is gitignored; never commit real values.

# ---------- Django ----------
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change_me
DJANGO_ALLOWED_HOSTS=pacific-disaster-api.spc.int,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://pacific-disaster-api.spc.int,http://localhost:8000,http://127.0.0.1:8000
# Production only: HTTPS-only session/CSRF cookies
DJANGO_SECURE_COOKIES=true
# DJANGO_DEBUG / CORS_ALLOW_ALL_ORIGINS default to on locally, off in production.
API_TOKEN_LIFETIME_DAYS=2

# ---------- Database ----------
# Also used by the postgres container to create the DB on first boot.
POSTGRES_DB=partner-api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Docker ports / gunicorn ----------
DJANGO_LOCAL_PORT=8000
NGINX_PORT=8089
POSTGRES_PUBLIC_PORT=5439
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ---------- Email (SendGrid SMTP) ----------
SENDGRID_SMTP_HOST=smtp.sendgrid.net
SENDGRID_SMTP_PORT=587
SENDGRID_SMTP_USERNAME=apikey
SENDGRID_SMTP_PASSWORD=change_me
SENDGRID_FROM_NAME=GEM OPM
SENDGRID_FROM_EMAIL=opm@spc.int
SENDGRID_REPLY_TO=opm@spc.int

# ---------- Mailer ----------
MAIL_CONFIG_ENCRYPTION_KEY=change_me
# MAILER_DEFAULT_CONFIGURATION_NAME=
